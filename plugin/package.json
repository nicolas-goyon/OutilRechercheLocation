{
  "name": "tm-recherche-logement",
  "version": "0.2.0",
  "private": true,
  "description": "Plugin Tampermonkey. Masque et étiquette les annonces immobilières. Synchronise les annonces avec le serveur local (../server).",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**' tests/*.test.ts",
    "test:live": "node --import tsx --test tests-live/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "linkedom": "^0.18.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolas-goyon/OutilRechercheLocation.git"
  }
}
