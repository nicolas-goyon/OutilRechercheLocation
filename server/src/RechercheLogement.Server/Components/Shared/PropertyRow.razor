@* Un bien sur une ligne (vue liste). *@
<article class="row @Format.StatusClass(Item.Property.Status)" data-property="@Item.Property.Id">
    <div class="row-photo">
        <PhotoCarousel Photos="Item.Photos ?? []" Href="@($"/biens/{Item.Property.Id}")" Width="240" Height="180" />
    </div>
    <div class="row-main">
        <a class="title" href="/biens/@Item.Property.Id">@(Item.Title ?? "Annonce")</a>
        <div class="muted">@Item.PostalCode @Item.City @(Item.District is not null ? $"({Item.District})" : "")</div>
    </div>
    <div class="row-price">
        <div class="price">@Format.Price(Item.Price)</div>
        <div class="muted">@Format.Surface(Item.Surface)@(Item.Rooms is not null ? $", {Item.Rooms} p." : "")</div>
    </div>
    <StatusBadge Status="Item.Property.Status" Stage="Item.Property.ContactStage" />
    <StatusButtons PropertyId="@Item.Property.Id" Current="Item.Property.Status" />
</article>

@code {
    [Parameter, EditorRequired] public PropertySummary Item { get; set; } = default!;
}
