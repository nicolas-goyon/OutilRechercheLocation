@inject IJSRuntime JS

@* Photos d'un bien : grand carrousel, 3 vignettes et une case « + X photos ». Un clic ouvre la galerie en grand. *@
@if (Photos.Count > 0)
{
    <div class="gallery">
        <div class="gallery-main">
            <button type="button" class="gallery-open" aria-label="Agrandir la photo @(_index + 1)" @onclick="() => Open(_index)">
                <img src="@Photos[_index]" alt="" />
            </button>
            @if (Photos.Count > 1)
            {
                <button type="button" class="carousel-nav prev" aria-label="Photo précédente" @onclick="() => Move(-1)"><Icon Name="arrow-left" /></button>
                <button type="button" class="carousel-nav next" aria-label="Photo suivante" @onclick="() => Move(1)"><Icon Name="arrow-right" /></button>
                <span class="carousel-count">@(_index + 1)/@Photos.Count</span>
            }
        </div>
        @if (Photos.Count > 1)
        {
            <div class="gallery-thumbs">
                @for (var i = 0; i < Math.Min(Photos.Count, Shown); i++)
                {
                    var index = i;
                    var more = i == Shown - 1 && Photos.Count > Shown;
                    <button type="button" class="gallery-thumb @(index == _index && !more ? "on" : "")"
                            aria-label="@(more ? $"Voir les {Photos.Count} photos" : $"Photo {index + 1}")"
                            @onclick="() => { if (more) Open(index); else _index = index; }">
                        <img src="@Format.Thumb(Photos[index], 320, 220)" alt="" loading="lazy" />
                        @if (more) { <span class="gallery-more">+ @(Photos.Count - Shown + 1) photos</span> }
                    </button>
                }
            </div>
        }
    </div>

    @if (_open)
    {
        <dialog class="gallery-dialog" @ref="_dialog" aria-label="Photos du bien" @oncancel="Close" @onkeydown="OnKey">
            <div class="gallery-dialog-main">
                <img src="@Photos[_index]" alt="Photo @(_index + 1) sur @Photos.Count" />
                @if (Photos.Count > 1)
                {
                    <button type="button" class="carousel-nav prev" aria-label="Photo précédente" @onclick="() => Move(-1)"><Icon Name="arrow-left" /></button>
                    <button type="button" class="carousel-nav next" aria-label="Photo suivante" @onclick="() => Move(1)"><Icon Name="arrow-right" /></button>
                }
                <span class="gallery-dialog-count">@(_index + 1)/@Photos.Count</span>
                <button type="button" class="gallery-close" aria-label="Fermer" @onclick="Close"><Icon Name="x" /></button>
            </div>
            <div class="gallery-strip" @ref="_strip">
                @for (var i = 0; i < Photos.Count; i++)
                {
                    var index = i;
                    <button type="button" class="gallery-thumb @(index == _index ? "on" : "")" aria-label="Photo @(index + 1)" aria-current="@(index == _index ? "true" : null)" @onclick="() => _index = index">
                        <img src="@Format.Thumb(Photos[index], 200, 140)" alt="" loading="lazy" />
                    </button>
                }
            </div>
        </dialog>
    }
}

@code {
    /// <summary>Cases sous le grand carrousel ; la dernière ouvre la galerie quand il y a plus de photos.</summary>
    private const int Shown = 4;

    [Parameter, EditorRequired] public IReadOnlyList<string> Photos { get; set; } = [];

    private ElementReference _dialog, _strip;
    private int _index;
    private bool _open, _justOpened;

    protected override void OnParametersSet()
    {
        if (_index >= Photos.Count) _index = 0;
    }

    private void Move(int delta)
    {
        _index = (_index + delta + Photos.Count) % Photos.Count;
    }

    private void Open(int index)
    {
        _index = index;
        _open = true;
        _justOpened = true;
    }

    private void Close() => _open = false;

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowLeft") Move(-1);
        else if (e.Key == "ArrowRight") Move(1);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_open) return;
        if (_justOpened)
        {
            _justOpened = false;
            await JS.InvokeVoidAsync("rl.openDialog", _dialog);
        }
        // Miniature active toujours visible dans la bande.
        await JS.InvokeVoidAsync("rl.showActive", _strip);
    }
}
