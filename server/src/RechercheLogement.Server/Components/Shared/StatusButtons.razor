@* Boutons de statut rapides (les mêmes que dans le plugin). *@
<div class="status-buttons">
    @foreach (var s in new[] { PropertyStatus.Seen, PropertyStatus.Rejected, PropertyStatus.ToContact })
    {
        var active = Current == s;
        <button type="button" class="sb @Format.StatusClass(s) @(active ? "active" : "")"
                title="@(active ? $"Annuler : {Labels.Of(s)}" : Labels.Of(s))" aria-label="@(active ? $"Annuler : {Labels.Of(s)}" : Labels.Of(s))"
                @onclick="() => Catalog.SetStatus(PropertyId, active ? PropertyStatus.None : s)"><Icon Name="@Format.StatusIcon(s)" /></button>
    }
</div>

@code {
    [Inject] private Catalog Catalog { get; set; } = default!;
    [Parameter, EditorRequired] public string PropertyId { get; set; } = "";
    [Parameter, EditorRequired] public PropertyStatus Current { get; set; }
}
