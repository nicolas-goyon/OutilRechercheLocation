@page "/parametres"
@using RechercheLogement.Server.Api
@inject ApiTokenService Tokens
@inject ServerSettings Settings
@inject IJSRuntime JS

<PageTitle>Paramètres — Recherche logement</PageTitle>
<h1>⚙ Paramètres</h1>

<section class="panel">
    <h2>Token du plugin</h2>
    <p>Le plugin Tampermonkey doit envoyer ce token pour lire ou modifier les données. Ne pas partager ce token.</p>
    <div class="token">
        <code>@(_show ? _token : new string('•', 24))</code>
        <button type="button" @onclick="() => _show = !_show">@(_show ? "Masquer" : "Afficher")</button>
        <button type="button" @onclick="() => Copy(_token)">Copier</button>
        @if (!Tokens.FromConfiguration)
        {
            <button type="button" class="danger" @onclick="Regenerate">Régénérer</button>
        }
    </div>
    @if (Tokens.FromConfiguration)
    {
        <p class="muted">La variable d'environnement <code>RechercheLogement__ApiToken</code> fixe ce token.</p>
    }
    @if (_regenerated)
    {
        <p class="warn">Nouveau token créé. Le serveur refuse maintenant l'ancien token. Coller le nouveau token dans le plugin (panneau 🏠 > Connexion).</p>
    }
</section>

<section class="panel">
    <h2>Installer le plugin</h2>
    <ol class="steps">
        <li>Installer Tampermonkey dans le navigateur.</li>
        <li>Ouvrir <a href="@Settings.PluginInstallUrl" target="_blank" rel="noopener">le script du plugin ↗</a>
            et cliquer sur <b>Installer</b>. Le plugin se met ensuite à jour automatiquement à chaque nouvelle version.</li>
        <li>Ouvrir une recherche sur un site d'annonces (bienici.com, seloger.com…). Au premier lancement, le panneau 🏠 s'ouvre.</li>
        <li>Dans <b>Connexion au serveur local</b>, garder l'URL <code>@Settings.PublicUrl</code>.</li>
        <li>Coller le token ci-dessus
            (<button type="button" class="link" @onclick="() => Copy(_token)">copier</button>).</li>
        <li>Cliquer sur <b>Tester</b>, puis sur <b>Enregistrer</b>.</li>
    </ol>
    <p class="muted">Le script publié ne contient jamais le token. Le token reste dans le stockage Tampermonkey de votre navigateur.
        Les mises à jour du plugin ne changent pas ce stockage. Après une régénération, coller le nouveau token dans le panneau 🏠.</p>
</section>

<section class="panel">
    <h2>Sauvegarde</h2>
    <p>La base SQLite est dans <code>@Settings.DatabasePath</code> (volume Docker <code>recherche-logement-data</code>). Le bouton ci-dessous exporte toutes les données en JSON.</p>
    <button type="button" @onclick="Export">⬇ Exporter (JSON)</button>
</section>

@code {
    [Inject] private Catalog Catalog { get; set; } = default!;

    private string _token = "";
    private bool _show;
    private bool _regenerated;

    protected override void OnInitialized() => _token = Tokens.Current;


    private void Regenerate()
    {
        _token = Tokens.Regenerate();
        _regenerated = true;
        _show = true;
    }

    private async Task Copy(string text) => await JS.InvokeVoidAsync("rl.copy", text);

    private async Task Export()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(Catalog.Export(), JsonDefaults.Options);
        await JS.InvokeVoidAsync("rl.download", $"recherche-logement-{DateTime.Now:yyyy-MM-dd}.json", json);
    }
}
