@page "/"
@inherits LiveComponent

<PageTitle>Tableau de bord — Recherche logement</PageTitle>
<h1>Tableau de bord</h1>

<div class="stats">
    <a class="stat tocontact" href="/a-contacter"><b>@Count(PropertyStatus.ToContact)</b><span>📞 à contacter</span></a>
    <a class="stat seen" href="/biens?statut=seen"><b>@Count(PropertyStatus.Seen)</b><span>👁 vus</span></a>
    <a class="stat rejected" href="/biens?statut=rejected"><b>@Count(PropertyStatus.Rejected)</b><span>✕ pas intéressé</span></a>
    <a class="stat" href="/biens?statut=none"><b>@Count(PropertyStatus.None)</b><span>sans statut</span></a>
    <a class="stat suggest" href="/doublons"><b>@_stats.PendingDuplicates</b><span>≈ doublons à vérifier</span></a>
</div>
<p class="muted">
    @_stats.Listings annonces pour @_stats.Properties biens.
    Par site : @string.Join(" · ", _stats.BySite.Select(kv => $"{Labels.Site(kv.Key)} : {kv.Value}"))
</p>

<h2>⭐ Recherches favorites</h2>
@if (_searches.Count == 0)
{
    <p class="muted">Aucune recherche enregistrée. <a href="/recherches">Ajouter une recherche</a></p>
}
else
{
    <div class="quick-searches">
        @foreach (var s in _searches)
        {
            <a href="@s.Url" target="_blank" rel="noopener" title="@s.Url" @onclick="() => Catalog.MarkSearchOpened(s.Id)">@Labels.Site(s.Site) · @s.Name ↗</a>
        }
        <a href="/recherches">Gérer…</a>
    </div>
}

<h2>📞 Suivi des contacts</h2>
@if (_toContact.Count == 0)
{
    <p class="muted">Aucun bien à contacter. Pour ajouter un bien, cliquer sur le bouton 📞 dans le plugin.</p>
}
else
{
    <div class="grid">
        @foreach (var p in _toContact) { <PropertyCard Item="p" /> }
    </div>
}

<h2>Vus récemment</h2>
<div class="grid">
    @foreach (var p in _recent) { <PropertyCard Item="p" /> }
</div>

@code {
    private CatalogStats _stats = default!;
    private IReadOnlyList<PropertySummary> _toContact = [];
    private IReadOnlyList<PropertySummary> _recent = [];
    private IReadOnlyList<SavedSearch> _searches = [];

    protected override void Load()
    {
        _stats = Catalog.Stats();
        _searches = Catalog.Searches();
        _toContact = Catalog.QueryProperties(new PropertyQuery { Statuses = new HashSet<PropertyStatus> { PropertyStatus.ToContact }, Sort = PropertySort.LastUpdate, Take = 12 });
        _recent = Catalog.QueryProperties(new PropertyQuery { Statuses = new HashSet<PropertyStatus> { PropertyStatus.None, PropertyStatus.Seen }, Take = 12 });
    }

    private int Count(PropertyStatus s) => _stats.ByStatus.GetValueOrDefault(s);
}
