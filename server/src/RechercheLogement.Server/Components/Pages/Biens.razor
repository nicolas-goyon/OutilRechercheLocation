@page "/biens"
@inherits LiveComponent

@inject IJSRuntime JS

<PageTitle>Biens — Recherche logement</PageTitle>
<h1>Tous les biens</h1>

<div class="filters">
    <div class="chips">
        @foreach (var s in Enum.GetValues<PropertyStatus>())
        {
            <label class="chip @Format.StatusClass(s) @(_statuses.Contains(s) ? "on" : "")">
                <input type="checkbox" checked="@_statuses.Contains(s)" @onchange="() => Toggle(s)" />
                <Icon Name="@Format.StatusIcon(s)" /> @Labels.Of(s)
            </label>
        }
    </div>
    <input placeholder="Recherche (titre, ville, note...)" @bind="_text" @bind:event="oninput" @bind:after="Load" />
    <input placeholder="Code postal" @bind="_postalCode" @bind:event="oninput" @bind:after="Load" class="small" />
    <input type="number" placeholder="Prix max" @bind="_maxPrice" @bind:after="Load" class="small" />
    <input type="number" placeholder="Surface min" @bind="_minSurface" @bind:after="Load" class="small" />
    <select @bind="_sort" @bind:after="Load">
        <option value="@PropertySort.LastSeen">Vus récemment</option>
        <option value="@PropertySort.LastUpdate">Modifiés récemment</option>
        <option value="@PropertySort.PriceAsc">Prix croissant</option>
        <option value="@PropertySort.PriceDesc">Prix décroissant</option>
        <option value="@PropertySort.SurfaceDesc">Surface décroissante</option>
    </select>
</div>

<div class="view-bar">
    <p class="muted">@_items.Count bien(s)@(_items.Count >= Take ? $" (les {Take} premiers)" : "")</p>
    <div class="segmented" role="group" aria-label="Affichage">
        <button type="button" class="@(_view == "grid" ? "on" : "")" aria-pressed="@(_view == "grid" ? "true" : "false")" @onclick="@(() => SetView("grid"))"><Icon Name="layout-dashboard" /> Grille</button>
        <button type="button" class="@(_view == "list" ? "on" : "")" aria-pressed="@(_view == "list" ? "true" : "false")" @onclick="@(() => SetView("list"))"><Icon Name="list-checks" /> Liste</button>
    </div>
    <button type="button" class="@(_map ? "toggle on" : "toggle")" aria-pressed="@(_map ? "true" : "false")" @onclick="ToggleMap"><Icon Name="map" /> Carte</button>
</div>

<div class="@(_map ? "with-map" : "")">
    <div class="property-list">
        @if (_view == "list")
        {
            <div class="rows">
                @foreach (var p in _items) { <PropertyRow @key="p.Property.Id" Item="p" /> }
            </div>
        }
        else
        {
            <div class="grid">
                @foreach (var p in _items)
                {
                    <div @key="p.Property.Id" class="grid-item" data-property="@p.Property.Id"><PropertyCard Item="p" /></div>
                }
            </div>
        }
    </div>
    @if (_map) { <PropertyMap Items="_items" /> }
</div>

@code {
    private const int Take = 300;

    [SupplyParameterFromQuery(Name = "statut")] public string? StatusParam { get; set; }

    private HashSet<PropertyStatus> _statuses = [PropertyStatus.None, PropertyStatus.Seen, PropertyStatus.ToContact];
    private string? _text;
    private string? _postalCode;
    private decimal? _maxPrice;
    private double? _minSurface;
    private PropertySort _sort = PropertySort.LastSeen;
    private IReadOnlyList<PropertySummary> _items = [];
    private string _view = "grid";
    private bool _map;

    protected override void OnInitialized()
    {
        if (StatusParam is not null && Enum.TryParse<PropertyStatus>(StatusParam, ignoreCase: true, out var s)) _statuses = [s];
        base.OnInitialized();
    }

    protected override void Load()
    {
        _items = Query();
        ShowPhotos(_items.Select(p => p.Property.Id));
    }

    private IReadOnlyList<PropertySummary> Query() => Catalog.QueryProperties(new PropertyQuery
    {
        Statuses = _statuses,
        Text = _text,
        PostalCode = _postalCode,
        MaxPrice = _maxPrice,
        MinSurface = _minSurface,
        Sort = _sort,
        Take = Take,
        Scope = Selection.Scope,
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Choix gardés dans le navigateur : connus une fois la page interactive.
        _view = await JS.InvokeAsync<string?>("rl.prefs.get", "rl-biens-view") == "list" ? "list" : "grid";
        _map = await JS.InvokeAsync<string?>("rl.prefs.get", "rl-biens-map") == "on";
        StateHasChanged();
    }

    private async Task SetView(string view)
    {
        _view = view;
        await JS.InvokeVoidAsync("rl.prefs.set", "rl-biens-view", view);
    }

    private async Task ToggleMap()
    {
        _map = !_map;
        await JS.InvokeVoidAsync("rl.prefs.set", "rl-biens-map", _map ? "on" : null);
    }

    private void Toggle(PropertyStatus s)
    {
        if (!_statuses.Remove(s)) _statuses.Add(s);
        Load();
    }
}
