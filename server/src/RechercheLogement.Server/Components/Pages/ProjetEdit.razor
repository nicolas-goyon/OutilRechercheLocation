@page "/projets/nouveau"
@page "/projets/{Id}/modifier"
@inject ProjectStore Store
@inject ProjectRunner Runner
@inject SiteRegistry Sites
@inject NavigationManager Nav
@inject GeoServices Geo
@using RechercheLogement.Server.Geo
@implements IDisposable

<PageTitle>@(_isNew ? "Nouveau projet" : $"Modifier « {_name} »") — Recherche logement</PageTitle>
<h1>@(_isNew ? "Nouveau projet" : $"Modifier « {_name} »")</h1>

@if (_notFound)
{
    <p>Projet introuvable. <a href="/projets">Retour aux projets</a></p>
    return;
}

<section class="panel">
    <h2>Le projet</h2>
    <div class="form-grid">
        <label>Nom</label>
        <input @bind="_name" @bind:event="oninput" placeholder="Ex. « T2 Rodez, 700 € max »" />

        <label>Transaction</label>
        <select @bind="_transaction">
            <option value="@TransactionType.Rent">Location</option>
            <option value="@TransactionType.Buy">Achat</option>
        </select>

        <label>Type de bien</label>
        <div class="type-chips">
            @foreach (var (id, label) in PropertyTypes.All)
            {
                <label class="chip @(_types.Contains(id) ? "on" : "")">
                    <input type="checkbox" checked="@_types.Contains(id)" @onchange="() => ToggleType(id)" /> @label
                </label>
            }
        </div>

    </div>
</section>

<section class="panel">
    <h2>Zone de recherche</h2>
    <div class="mode-tabs">
        <label class="chip @(_mode == LocationMode.Places ? "on" : "")"><input type="radio" name="mode" checked="@(_mode == LocationMode.Places)" @onchange="() => SetMode(LocationMode.Places)" />Villes, codes postaux, départements, régions</label>
        <label class="chip @(_mode == LocationMode.Radius ? "on" : "")"><input type="radio" name="mode" checked="@(_mode == LocationMode.Radius)" @onchange="() => SetMode(LocationMode.Radius)" />Rayon autour d'un point</label>
        <label class="chip @(_mode == LocationMode.TravelTime ? "on" : "")"><input type="radio" name="mode" checked="@(_mode == LocationMode.TravelTime)" @onchange="() => SetMode(LocationMode.TravelTime)" />Temps de trajet autour d'un point</label>
    </div>
    <div class="form-grid">
        @if (_mode == LocationMode.Places)
        {
            <label>Lieux</label>
            <div>
                @if (_places.Count > PlacesFolded)
                {
                    <div class="tags-count muted small">@_places.Count lieux</div>
                }
                <div class="tags-input @(_placesOpen && _places.Count > PlacesFolded ? "open" : "")">
                    @foreach (var l in _placesOpen ? _places : _places.Take(PlacesFolded))
                    {
                        <span class="tag @(l.Type == PlaceType.Free ? "free" : "")" title="@PlaceTitle(l)">
                            <Icon Name="@PlaceIcon(l.Type)" /> @l.Display()
                            <button type="button" title="Retirer ce lieu" @onclick="() => RemovePlace(l)">×</button>
                        </span>
                    }
                    @if (_places.Count > PlacesFolded)
                    {
                        <button type="button" class="tags-more" @onclick="() => _placesOpen = !_placesOpen">
                            @(_placesOpen ? "Réduire" : $"+ {_places.Count - PlacesFolded} autres lieux")
                        </button>
                    }
                    <SuggestInput @bind-Value="_placeText" Search="Geo.SuggestPlacesAsync" OnPick="AddPlace" OnBackspaceEmpty="RemoveLastPlace"
                                  ClearOnPick="true" SplitOnSeparators="true"
                                  Placeholder="@(_places.Count == 0 ? "Ville, code postal, département ou région…" : "Ajouter un lieu…")" />
                </div>
                <div class="muted small">
                    Taper puis Entrée (ou choisir dans la liste) : chaque lieu reconnu devient une étiquette, et sa zone s'affiche sur la carte.
                    Un clic sur la carte ajoute la commune cliquée ; « Sélectionner sur la carte » ouvre une fenêtre pour choisir aussi des codes postaux, départements, régions ou un rayon. Chaque site reçoit ces lieux ; celui qu'il a reconnu s'affiche après le premier lancement.
                </div>
            </div>
        }
        else
        {
            <label>Point de départ</label>
            <div>
                <SuggestInput Value="@_center" ValueChanged="OnCenterText" Search="Geo.SuggestAddressesAsync" OnPick="PickCenter" MinLength="3"
                              Placeholder="Adresse, ville… ou cliquer sur la carte" />
                <div class="muted small">
                    @if (_centerPoint is { } c)
                    {
                        <span><Icon Name="map-pin" /> Point validé (@c.Lat.ToString("0.####", CultureInfo.InvariantCulture), @c.Lon.ToString("0.####", CultureInfo.InvariantCulture)) : glisser le marqueur ou cliquer sur la carte pour le déplacer.</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(_center))
                    {
                        <span>Adresse non validée : elle sera localisée au lancement. Choisir une suggestion pour la valider tout de suite.</span>
                    }
                    else
                    {
                        <span>Choisir une suggestion (base d'adresses nationale IGN) ou cliquer directement sur la carte.</span>
                    }
                </div>
            </div>
            @if (_mode == LocationMode.Radius)
            {
                <label>Rayon (km)</label>
                <div class="range"><input type="number" min="1" max="200" step="0.5" @bind="_radiusKm" @bind:event="oninput" @bind:after="Refit" /></div>
            }
            else
            {
                <label>Temps de trajet</label>
                <div class="range">
                    <input type="number" min="5" max="120" step="5" @bind="_travelMinutes" @bind:after="PreviewTravel" /> min
                    <select @bind="_travelBy" @bind:after="PreviewTravel">
                        <option value="@TravelMode.Car">en voiture</option>
                        <option value="@TravelMode.Bike">à vélo</option>
                        <option value="@TravelMode.Walk">à pied</option>
                    </select>
                </div>
            }
        }
        @if (_mode == LocationMode.Places)
        {
            <div class="zone-picker">
                <button type="button" @onclick="() => _picking = true"><Icon Name="map" /> Sélectionner sur la carte</button>
            </div>
        }
        <ZoneMap Center="MapCenter" RadiusKm="MapRadiusKm" Rings="MapRings" Markers="MapMarkers" Zones="MapZones" FitKey="@_fitKey.ToString(CultureInfo.InvariantCulture)" OnPoint="OnMapPoint" />
        @if (_mapMessage is not null)
        {
            <div class="map-help muted small">@_mapMessage</div>
        }
        @if (_mode != LocationMode.Places)
        {
            <div class="map-help muted small">
                Les sites ne cherchent pas dans un cercle ou par temps de trajet. Le serveur calcule la zone exacte
                (isochrone OpenStreetMap pour le temps de trajet, affichée ci-dessus), demande à chaque site les codes postaux qui la
                couvrent (ou les départements si elle est très grande), puis garde seulement les annonces situées dans
                la zone exacte (position de l'annonce, sinon centre de sa commune).
            </div>
        }
    </div>
</section>

@if (_picking)
{
    <ZonePicker Places="_places" OnSave="SavePicked" OnClose="() => _picking = false" />
}

<section class="panel">
    <h2>Critères</h2>
    <div class="form-grid">
        <label>Prix (€)</label>
        <div class="range"><input type="number" min="0" @bind="_priceMin" placeholder="min" /> à <input type="number" min="0" @bind="_priceMax" placeholder="max" /></div>

        <label>Surface (m²)</label>
        <div class="range"><input type="number" min="0" @bind="_surfaceMin" placeholder="min" /> à <input type="number" min="0" @bind="_surfaceMax" placeholder="max" /></div>

        <label>Pièces</label>
        <div class="range"><input type="number" min="1" @bind="_roomsMin" placeholder="min" /> à <input type="number" min="1" @bind="_roomsMax" placeholder="max" /></div>

        <label>Chambres (min)</label>
        <div class="range"><input type="number" min="0" @bind="_bedroomsMin" placeholder="min" /></div>

        <label>Meublé</label>
        <select @bind="_furnished">
            <option value="any">Indifférent</option>
            <option value="yes">Meublé</option>
            <option value="no">Non meublé</option>
        </select>

        <label>Mots-clés souhaités</label>
        <div>
            <input @bind="_include" @bind:event="oninput" placeholder="Ex. balcon, terrasse, parking" />
            <div class="muted small">Séparés par des virgules. L'annonce doit contenir au moins un de ces mots (titre ou description).</div>
        </div>

        <label>Mots-clés exclus</label>
        <div>
            <input @bind="_exclude" @bind:event="oninput" placeholder="Ex. colocation, viager" />
            <div class="muted small">L'annonce est écartée si elle contient un de ces mots.</div>
        </div>
    </div>
</section>

<section class="panel">
    <h2>Caractéristiques du bien</h2>
    <div class="form-grid">
        <label>Terrain (m²)</label>
        <div class="range"><input type="number" min="0" @bind="_landMin" placeholder="min" /> à <input type="number" min="0" @bind="_landMax" placeholder="max" /></div>

        <label>Salles de bain (min)</label>
        <div class="range"><input type="number" min="0" @bind="_bathroomsMin" placeholder="min" /></div>

        <label>DPE</label>
        <select @bind="_energyMax">
            <option value="">Indifférent</option>
            @foreach (var c in EnergyClasses.All.Take(6))
            {
                <option value="@c">@(c == "A" ? "A seulement" : $"A à {c}")</option>
            }
        </select>

        <label>Année de construction</label>
        <div class="range"><input type="number" min="1000" max="2100" @bind="_yearMin" placeholder="après" /> à <input type="number" min="1000" max="2100" @bind="_yearMax" placeholder="avant" /></div>

        <label>Neuf ou ancien</label>
        <select @bind="_newBuild">
            <option value="any">Indifférent</option>
            <option value="new">Neuf seulement</option>
            <option value="old">Ancien seulement</option>
        </select>

        <label>Travaux</label>
        <select @bind="_work">
            <option value="any">Indifférent</option>
            <option value="none">Sans travaux annoncés</option>
            <option value="needed">À rénover seulement</option>
        </select>

        <label>Équipements exigés</label>
        <div class="type-chips">
            @foreach (var (id, label) in Features.All)
            {
                <label class="chip @(_features.Contains(id) ? "on" : "")">
                    <input type="checkbox" checked="@_features.Contains(id)" @onchange="e => ToggleFeature(id, e.Value is true)" /> @label
                </label>
            }
        </div>

        @if (_transaction == TransactionType.Buy)
        {
            <label>Viager</label>
            <label><input type="checkbox" @bind="_excludeLifeAnnuity" /> Écarter les viagers</label>
        }
    </div>
    <p class="muted small">
        Chaque site applique ce qu'il sait filtrer ; l'outil vérifie le reste sur les annonces. L'outil n'écarte pas une
        annonce qui ne précise pas l'information (un DPE ou une piscine non mentionnés), mais un site peut le faire.
    </p>
</section>

<section class="panel">
    <h2>Sites interrogés</h2>
    @foreach (var group in Sites.All.GroupBy(s => s.Info.Category))
    {
        <h3>@SiteRegistry.CategoryLabel(group.Key)</h3>
        <div class="site-choices">
            @foreach (var site in group)
            {
                var id = site.Info.Id;
                <label class="site-choice @(site.Available ? "" : "disabled")" title="@site.Info.Description">
                    <input type="checkbox" disabled="@(!site.Available)" checked="@(site.Available && _sites.Contains(id))"
                           @onchange="e => ToggleSite(id, e.Value is true)" />
                    @site.Info.Label
                    @if (!site.Available) { <span class="badge">à venir</span> }
                </label>
            }
        </div>
    }
</section>

<section class="panel">
    <h2>Lancement</h2>
    <div class="form-grid">
        <label>Fréquence</label>
        <select @bind="_refresh">
            <option value="0">À la demande seulement</option>
            <option value="1">Toutes les heures</option>
            <option value="3">Toutes les 3 heures</option>
            <option value="6">Toutes les 6 heures</option>
            <option value="12">Toutes les 12 heures</option>
            <option value="24">Tous les jours</option>
        </select>

        <label>Actif</label>
        <label><input type="checkbox" @bind="_active" /> Lancer automatiquement (décocher pour mettre en pause)</label>
    </div>
</section>

@if (_errors.Count > 0)
{
    <ul class="warn">@foreach (var e in _errors) { <li>@e</li> }</ul>
}

<div class="form-actions">
    <button type="button" class="primary" @onclick="() => Save(run: true)">Enregistrer et lancer</button>
    <button type="button" @onclick="() => Save(run: false)">Enregistrer</button>
    <a class="button" href="@(_isNew ? "/projets" : $"/projets/{Id}")">Annuler</a>
    @if (!_isNew)
    {
        <span class="spacer"></span>
        @if (_confirmDelete)
        {
            <button type="button" class="danger" @onclick="Delete">Confirmer : supprimer le projet et ses résultats</button>
            <button type="button" @onclick="() => _confirmDelete = false">Annuler</button>
        }
        else
        {
            <button type="button" class="danger" @onclick="() => _confirmDelete = true"><Icon Name="trash-2" /> Supprimer</button>
        }
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }

    private bool _isNew => Id is null;
    private bool _notFound;
    private bool _confirmDelete;
    private SearchProject? _existing;
    private readonly List<string> _errors = [];

    private string _name = "";
    private TransactionType _transaction = TransactionType.Rent;
    private HashSet<string> _types = [PropertyTypes.Flat];

    private void ToggleType(string id)
    {
        if (!_types.Remove(id)) _types.Add(id);
    }
    private LocationMode _mode = LocationMode.Places;
    private List<ProjectLocation> _places = [];
    /// <summary>Au-delà, les lieux sont repliés (le pinceau en ajoute facilement des centaines).</summary>
    private const int PlacesFolded = 24;
    private bool _placesOpen;
    private string _placeText = "";
    private string _center = "";
    /// <summary>Point de départ validé (suggestion, clic ou marqueur déplacé) ; null : texte libre, géocodé au lancement.</summary>
    private GeoPoint? _centerPoint;
    /// <summary>Texte affiché pour <see cref="_centerPoint"/> : le modifier à la main invalide le point.</summary>
    private string? _centerPicked;
    private int _fitKey;
    private bool _picking;
    private string? _mapMessage;
    private List<List<GeoPoint>>? _previewRings;
    private string? _previewKey;
    private CancellationTokenSource? _previewCts;
    private double _radiusKm = 10;
    private int _travelMinutes = 30;
    private TravelMode _travelBy = TravelMode.Car;
    private decimal? _priceMin, _priceMax;
    private double? _surfaceMin, _surfaceMax;
    private int? _roomsMin, _roomsMax, _bedroomsMin;
    private string _furnished = "any";
    private double? _landMin, _landMax;
    private int? _bathroomsMin, _yearMin, _yearMax;
    private string _energyMax = "";
    private string _newBuild = "any";
    private string _work = "any";
    private HashSet<string> _features = [];
    private bool _excludeLifeAnnuity = true;
    private string _include = "";
    private string _exclude = "";
    private HashSet<string> _sites = ["bienici", "seloger"];
    private int _refresh = 6;
    private bool _active = true;

    protected override void OnParametersSet()
    {
        if (Id is null) return;
        _existing = Store.Get(Id);
        if (_existing is null)
        {
            _notFound = true;
            return;
        }
        var p = _existing;
        _name = p.Name;
        _transaction = p.Transaction;
        _types = p.PropertyTypes.Select(PropertyTypes.Normalize).OfType<string>().ToHashSet();
        _mode = p.LocationMode;
        _places = [.. p.Locations];
        _center = p.CenterLabel ?? p.CenterQuery ?? "";
        _centerPoint = p.Center;
        _centerPicked = _centerPoint is null ? null : _center;
        // Zone de trajet déjà calculée au dernier lancement : affichée telle quelle.
        if (p.Area is { Shape.Rings.Count: > 0 } area && area.Fingerprint == p.AreaFingerprint() && p.LocationMode == LocationMode.TravelTime)
        {
            _previewRings = area.Shape.Rings;
            _previewKey = TravelKey(p.Center, p.TravelMinutes, p.TravelBy);
        }
        _radiusKm = p.RadiusKm;
        _travelMinutes = p.TravelMinutes;
        _travelBy = p.TravelBy;
        (_priceMin, _priceMax, _surfaceMin, _surfaceMax) = (p.PriceMin, p.PriceMax, p.SurfaceMin, p.SurfaceMax);
        (_roomsMin, _roomsMax, _bedroomsMin) = (p.RoomsMin, p.RoomsMax, p.BedroomsMin);
        _furnished = p.Furnished switch { true => "yes", false => "no", _ => "any" };
        (_landMin, _landMax, _bathroomsMin, _yearMin, _yearMax) = (p.LandSurfaceMin, p.LandSurfaceMax, p.BathroomsMin, p.YearBuiltMin, p.YearBuiltMax);
        _energyMax = p.EnergyClassMax ?? "";
        _newBuild = p.NewBuild switch { true => "new", false => "old", _ => "any" };
        _work = p.WorkNeeded switch { true => "needed", false => "none", _ => "any" };
        _features = [.. p.RequiredFeatures];
        _excludeLifeAnnuity = p.ExcludeLifeAnnuity;
        _include = string.Join(", ", p.KeywordsInclude);
        _exclude = string.Join(", ", p.KeywordsExclude);
        _sites = [.. p.Sites];
        _refresh = p.AutoRefreshHours;
        _active = p.Active;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) PreviewTravel();
    }

    // ------------------------------------------------------------------ zone : lieux

    private static string PlaceIcon(PlaceType type) => type switch
    {
        PlaceType.Commune => "building-2",
        PlaceType.PostalCode => "mail-open",
        PlaceType.Department => "map",
        PlaceType.Region => "compass",
        _ => "pencil",
    };

    private static string PlaceTitle(ProjectLocation l) => l.Type switch
    {
        PlaceType.Commune => $"Commune {l.Query} · codes postaux {string.Join(", ", l.PostalCodes)}",
        PlaceType.PostalCode => $"Code postal {l.Code}",
        PlaceType.Department => $"Département {l.Query} ({l.Code})",
        PlaceType.Region => $"Région {l.Query} · {string.Join(", ", l.Departments)}",
        _ => "Saisi librement (ancien projet) : transmis tel quel aux sites",
    };

    private void AddPlace(PlaceSuggestion s)
    {
        if (s.Location is not { } l) return;
        _mapMessage = null;
        if (_places.Any(x => x.Key() == l.Key()))
        {
            _mapMessage = $"« {l.Display()} » est déjà dans la liste.";
            return;
        }
        _places.Add(l);
        _fitKey++;
    }

    private void RemovePlace(ProjectLocation l)
    {
        _places.Remove(l);
        _mapMessage = null;
        _fitKey++;
    }

    private void RemoveLastPlace()
    {
        if (_places.Count > 0) RemovePlace(_places[^1]);
    }

    /// <summary>« Enregistrer les zones » dans la modale de sélection.</summary>
    private void SavePicked(List<ProjectLocation> places)
    {
        _places = places;
        _picking = false;
        _mapMessage = null;
        _fitKey++;
    }

    // ------------------------------------------------------------------ zone : point de départ et carte

    private GeoPoint? MapCenter => _mode == LocationMode.Places ? null : _centerPoint;
    private double? MapRadiusKm => _mode == LocationMode.Radius ? _radiusKm : null;
    private List<List<GeoPoint>>? MapRings =>
        _mode == LocationMode.TravelTime && _previewKey is not null && _previewKey == TravelKey(_centerPoint, _travelMinutes, _travelBy) ? _previewRings : null;
    private List<ZoneMap.Marker> MapMarkers => _mode != LocationMode.Places ? [] :
        _places.Where(l => !HasContour(l) && l.Center is not null).Select(l => new ZoneMap.Marker(l.Center!, l.Display())).ToList();
    private List<ZoneMap.Zone> MapZones => _mode != LocationMode.Places ? [] :
        _places.Where(HasContour).Select(l => new ZoneMap.Zone(l.Type, l.Code!, l.Display(), l.Center)).ToList();

    private static bool HasContour(ProjectLocation l) => l.Type != PlaceType.Free && !string.IsNullOrEmpty(l.Code);

    private static string? TravelKey(GeoPoint? c, int minutes, TravelMode by) =>
        c is null ? null : FormattableString.Invariant($"{c.Lat:0.#####},{c.Lon:0.#####}|{minutes}|{by}");

    private void SetMode(LocationMode mode)
    {
        _mode = mode;
        _mapMessage = null;
        _fitKey++;
        PreviewTravel();
    }

    private void Refit() => _fitKey++;

    private void OnCenterText(string text)
    {
        _center = text;
        // Texte modifié à la main : le point n'est plus celui choisi.
        if (_centerPoint is not null && text != _centerPicked)
        {
            _centerPoint = null;
            _centerPicked = null;
        }
    }

    private void PickCenter(PlaceSuggestion s)
    {
        if (s.Point is null) return;
        SetCenter(s.Point, s.Label);
        _fitKey++;
    }

    private void SetCenter(GeoPoint point, string label)
    {
        _centerPoint = point;
        _center = label;
        _centerPicked = label;
        _mapMessage = null;
        PreviewTravel();
    }

    /// <summary>Clic sur la carte (ou marqueur déplacé) : commune ajoutée (mode lieux) ou point de départ déplacé.</summary>
    private async Task OnMapPoint(GeoPoint point)
    {
        _mapMessage = null;
        try
        {
            if (_mode == LocationMode.Places)
            {
                if (await Geo.CommuneAtAsync(point, CancellationToken.None) is { } commune) AddPlace(commune);
                else _mapMessage = "Aucune commune française à cet endroit.";
                return;
            }
            SetCenter(point, FormattableString.Invariant($"{point.Lat:0.#####}, {point.Lon:0.#####}"));
            // Adresse la plus proche, si le point n'a pas encore changé entre-temps.
            if (await Geo.ReverseAsync(point, CancellationToken.None) is { } place && _centerPoint == point)
            {
                _center = place.Label;
                _centerPicked = place.Label;
            }
        }
        catch (SiteException e)
        {
            _mapMessage = e.Message;
        }
    }

    /// <summary>Mode temps de trajet : calcule et affiche la zone atteignable (après une courte pause de saisie).</summary>
    private void PreviewTravel()
    {
        if (_mode != LocationMode.TravelTime || _travelMinutes is < 5 or > 120) return;
        var key = TravelKey(_centerPoint, _travelMinutes, _travelBy);
        if (key is null || key == _previewKey) return;
        _previewCts?.Cancel();
        _previewCts = new CancellationTokenSource();
        _ = LoadTravelAsync(_centerPoint!, _travelMinutes, _travelBy, key, _previewCts.Token);
    }

    private async Task LoadTravelAsync(GeoPoint center, int minutes, TravelMode by, string key, CancellationToken ct)
    {
        _mapMessage = "Calcul de la zone de trajet…";
        try
        {
            await Task.Delay(600, ct);
            var shape = await Geo.IsochroneAsync(center, minutes, by, ct);
            _previewRings = shape.Rings;
            _previewKey = key;
            _mapMessage = null;
            _fitKey++;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (SiteException e)
        {
            _mapMessage = $"Zone de trajet non affichée : {e.Message} Elle sera recalculée (ou estimée) au lancement.";
        }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _previewCts?.Cancel();
        _previewCts?.Dispose();
    }

    // ------------------------------------------------------------------ sites et enregistrement

    private void ToggleSite(string id, bool on)
    {
        if (on) _sites.Add(id);
        else _sites.Remove(id);
    }

    private void Save(bool run)
    {
        _errors.Clear();
        var sites = _sites.Where(s => Sites.Get(s) is { Available: true }).ToList();
        if (string.IsNullOrWhiteSpace(_name)) _errors.Add("Donner un nom au projet.");
        if (_types.Count == 0) _errors.Add("Choisir au moins un type de bien.");
        if (_mode == LocationMode.Places && _places.Count == 0) _errors.Add("Indiquer au moins un lieu (ville, code postal, département ou région).");
        if (_mode == LocationMode.Places && !string.IsNullOrWhiteSpace(_placeText)) _errors.Add($"Lieu non validé : « {_placeText.Trim()} ». Le choisir dans les suggestions (Entrée) ou l'effacer.");
        if (_mode != LocationMode.Places && _centerPoint is null && string.IsNullOrWhiteSpace(_center)) _errors.Add("Indiquer le point de départ (adresse, ville ou clic sur la carte).");
        if (_mode == LocationMode.Radius && _radiusKm is <= 0 or > 200) _errors.Add("Rayon entre 1 et 200 km.");
        if (_mode == LocationMode.TravelTime && _travelMinutes is < 5 or > 120) _errors.Add("Temps de trajet entre 5 et 120 minutes.");
        if (sites.Count == 0) _errors.Add("Choisir au moins un site.");
        if (_priceMin > _priceMax || _surfaceMin > _surfaceMax || _roomsMin > _roomsMax) _errors.Add("Un minimum est supérieur au maximum.");
        if (_errors.Count > 0) return;

        var p = _existing ?? new SearchProject { Id = SearchProject.NewId() };
        p.Name = _name.Trim();
        p.PropertyTypes = PropertyTypes.All.Select(t => t.Id).Where(_types.Contains).ToList();
        // Transaction changée : les lieux reconnus par les sites (qui en dépendent) sont redemandés.
        if (_existing is not null && _existing.Transaction != _transaction) p.PlaceCache.Clear();
        p.Transaction = _transaction;
        p.LocationMode = _mode;
        p.Locations = [.. _places];
        p.CenterQuery = string.IsNullOrWhiteSpace(_center) ? null : _center.Trim();
        // Point validé (suggestion ou carte) ; sinon le texte sera géocodé au lancement.
        p.Center = _centerPoint;
        p.CenterLabel = _centerPoint is null ? null : p.CenterQuery;
        p.RadiusKm = _radiusKm;
        p.TravelMinutes = _travelMinutes;
        p.TravelBy = _travelBy;
        // La zone (mode rayon / temps de trajet) est recalculée au prochain lancement si elle a changé (empreinte).
        (p.PriceMin, p.PriceMax, p.SurfaceMin, p.SurfaceMax) = (_priceMin, _priceMax, _surfaceMin, _surfaceMax);
        (p.RoomsMin, p.RoomsMax, p.BedroomsMin) = (_roomsMin, _roomsMax, _bedroomsMin);
        p.Furnished = _furnished switch { "yes" => true, "no" => false, _ => null };
        (p.LandSurfaceMin, p.LandSurfaceMax, p.BathroomsMin, p.YearBuiltMin, p.YearBuiltMax) = (_landMin, _landMax, _bathroomsMin, _yearMin, _yearMax);
        p.EnergyClassMax = EnergyClasses.Normalize(_energyMax);
        p.NewBuild = _newBuild switch { "new" => true, "old" => false, _ => null };
        p.WorkNeeded = _work switch { "needed" => true, "none" => false, _ => null };
        p.RequiredFeatures = Features.All.Select(f => f.Id).Where(_features.Contains).ToList();
        p.ExcludeLifeAnnuity = _excludeLifeAnnuity;
        p.KeywordsInclude = SplitWords(_include);
        p.KeywordsExclude = SplitWords(_exclude);
        p.Sites = sites;
        p.AutoRefreshHours = _refresh;
        p.Active = _active;
        Store.Save(p);
        if (run) _ = Task.Run(() => Runner.RunAsync(p.Id, CancellationToken.None));
        Nav.NavigateTo($"/projets/{p.Id}");
    }

    private void Delete()
    {
        if (Id is not null) Store.Delete(Id);
        Nav.NavigateTo("/projets");
    }

    private void ToggleFeature(string id, bool on)
    {
        if (on) _features.Add(id);
        else _features.Remove(id);
    }

    private static List<string> SplitWords(string text) =>
        text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
}
