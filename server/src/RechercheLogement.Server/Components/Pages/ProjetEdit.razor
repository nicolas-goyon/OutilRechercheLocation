@page "/projets/nouveau"
@page "/projets/{Id}/modifier"
@inject ProjectStore Store
@inject ProjectRunner Runner
@inject SiteRegistry Sites
@inject NavigationManager Nav

<PageTitle>@(_isNew ? "Nouveau projet" : $"Modifier « {_name} »") — Recherche logement</PageTitle>
<h1>@(_isNew ? "Nouveau projet" : $"Modifier « {_name} »")</h1>

@if (_notFound)
{
    <p>Projet introuvable. <a href="/projets">Retour aux projets</a></p>
    return;
}

<section class="panel">
    <h2>Le projet</h2>
    <div class="form-grid">
        <label>Nom</label>
        <input @bind="_name" @bind:event="oninput" placeholder="Ex. « T2 Rodez, 700 € max »" />

        <label>Transaction</label>
        <select @bind="_transaction">
            <option value="@TransactionType.Rent">Location</option>
            <option value="@TransactionType.Buy">Achat</option>
        </select>

        <label>Type de bien</label>
        <div class="checks">
            <label><input type="checkbox" @bind="_flat" /> Appartement</label>
            <label><input type="checkbox" @bind="_house" /> Maison</label>
        </div>

    </div>
</section>

<section class="panel">
    <h2>Zone de recherche</h2>
    <div class="mode-tabs">
        <label class="chip @(_mode == LocationMode.Places ? "on" : "")"><input type="radio" name="mode" checked="@(_mode == LocationMode.Places)" @onchange="() => _mode = LocationMode.Places" />Villes, codes postaux, départements</label>
        <label class="chip @(_mode == LocationMode.Radius ? "on" : "")"><input type="radio" name="mode" checked="@(_mode == LocationMode.Radius)" @onchange="() => _mode = LocationMode.Radius" />Rayon autour d'un point</label>
        <label class="chip @(_mode == LocationMode.TravelTime ? "on" : "")"><input type="radio" name="mode" checked="@(_mode == LocationMode.TravelTime)" @onchange="() => _mode = LocationMode.TravelTime" />Temps de trajet autour d'un point</label>
    </div>
    <div class="form-grid">
        @if (_mode == LocationMode.Places)
        {
            <label>Lieux</label>
            <div>
                <textarea rows="3" @bind="_locations" @bind:event="oninput" placeholder="Une ville, un code postal ou un département par ligne. Ex. :&#10;Rodez&#10;12850&#10;Aveyron"></textarea>
                <div class="muted small">Transmis tels quels à chaque site. Le lieu reconnu par chaque site s'affiche après le premier lancement.</div>
            </div>
        }
        else
        {
            <label>Point de départ</label>
            <div>
                <input @bind="_center" @bind:event="oninput" placeholder="Adresse, ville ou code postal. Ex. « 8 boulevard Gally, Rodez »" />
                <div class="muted small">Votre travail, une gare, un centre-ville… Localisé avec la base d'adresses nationale (IGN).</div>
            </div>
            @if (_mode == LocationMode.Radius)
            {
                <label>Rayon (km)</label>
                <div class="range"><input type="number" min="1" max="200" step="0.5" @bind="_radiusKm" /></div>
            }
            else
            {
                <label>Temps de trajet</label>
                <div class="range">
                    <input type="number" min="5" max="120" step="5" @bind="_travelMinutes" /> min
                    <select @bind="_travelBy">
                        <option value="@TravelMode.Car">en voiture</option>
                        <option value="@TravelMode.Bike">à vélo</option>
                        <option value="@TravelMode.Walk">à pied</option>
                    </select>
                </div>
            }
            <label></label>
            <div class="muted small">
                Les sites ne cherchent pas dans un cercle ou par temps de trajet. Le serveur calcule la zone exacte
                (isochrone OpenStreetMap pour le temps de trajet), demande à chaque site les codes postaux qui la
                couvrent (ou les départements si elle est très grande), puis garde seulement les annonces situées dans
                la zone exacte (position de l'annonce, sinon centre de sa commune).
            </div>
        }
    </div>
</section>

<section class="panel">
    <h2>Critères</h2>
    <div class="form-grid">
        <label>Prix (€)</label>
        <div class="range"><input type="number" min="0" @bind="_priceMin" placeholder="min" /> à <input type="number" min="0" @bind="_priceMax" placeholder="max" /></div>

        <label>Surface (m²)</label>
        <div class="range"><input type="number" min="0" @bind="_surfaceMin" placeholder="min" /> à <input type="number" min="0" @bind="_surfaceMax" placeholder="max" /></div>

        <label>Pièces</label>
        <div class="range"><input type="number" min="1" @bind="_roomsMin" placeholder="min" /> à <input type="number" min="1" @bind="_roomsMax" placeholder="max" /></div>

        <label>Chambres (min)</label>
        <div class="range"><input type="number" min="0" @bind="_bedroomsMin" placeholder="min" /></div>

        <label>Meublé</label>
        <select @bind="_furnished">
            <option value="any">Indifférent</option>
            <option value="yes">Meublé</option>
            <option value="no">Non meublé</option>
        </select>

        <label>Mots-clés souhaités</label>
        <div>
            <input @bind="_include" @bind:event="oninput" placeholder="Ex. balcon, terrasse, parking" />
            <div class="muted small">Séparés par des virgules. L'annonce doit contenir au moins un de ces mots (titre ou description).</div>
        </div>

        <label>Mots-clés exclus</label>
        <div>
            <input @bind="_exclude" @bind:event="oninput" placeholder="Ex. colocation, viager" />
            <div class="muted small">L'annonce est écartée si elle contient un de ces mots.</div>
        </div>
    </div>
</section>

<section class="panel">
    <h2>Sites interrogés</h2>
    @foreach (var group in Sites.All.GroupBy(s => s.Info.Category))
    {
        <h3>@SiteRegistry.CategoryLabel(group.Key)</h3>
        <div class="site-choices">
            @foreach (var site in group)
            {
                var id = site.Info.Id;
                <label class="site-choice @(site.Available ? "" : "disabled")" title="@site.Info.Description">
                    <input type="checkbox" disabled="@(!site.Available)" checked="@(site.Available && _sites.Contains(id))"
                           @onchange="e => ToggleSite(id, e.Value is true)" />
                    @site.Info.Label
                    @if (!site.Available) { <span class="badge">à venir</span> }
                </label>
            }
        </div>
    }
</section>

<section class="panel">
    <h2>Lancement</h2>
    <div class="form-grid">
        <label>Fréquence</label>
        <select @bind="_refresh">
            <option value="0">À la demande seulement</option>
            <option value="1">Toutes les heures</option>
            <option value="3">Toutes les 3 heures</option>
            <option value="6">Toutes les 6 heures</option>
            <option value="12">Toutes les 12 heures</option>
            <option value="24">Tous les jours</option>
        </select>

        <label>Actif</label>
        <label><input type="checkbox" @bind="_active" /> Lancer automatiquement (décocher pour mettre en pause)</label>
    </div>
</section>

@if (_errors.Count > 0)
{
    <ul class="warn">@foreach (var e in _errors) { <li>@e</li> }</ul>
}

<div class="form-actions">
    <button type="button" class="primary" @onclick="() => Save(run: true)">Enregistrer et lancer</button>
    <button type="button" @onclick="() => Save(run: false)">Enregistrer</button>
    <a class="button" href="@(_isNew ? "/projets" : $"/projets/{Id}")">Annuler</a>
    @if (!_isNew)
    {
        <span class="spacer"></span>
        @if (_confirmDelete)
        {
            <button type="button" class="danger" @onclick="Delete">Confirmer : supprimer le projet et ses résultats</button>
            <button type="button" @onclick="() => _confirmDelete = false">Annuler</button>
        }
        else
        {
            <button type="button" class="danger" @onclick="() => _confirmDelete = true">🗑 Supprimer</button>
        }
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }

    private bool _isNew => Id is null;
    private bool _notFound;
    private bool _confirmDelete;
    private SearchProject? _existing;
    private readonly List<string> _errors = [];

    private string _name = "";
    private TransactionType _transaction = TransactionType.Rent;
    private bool _flat = true;
    private bool _house;
    private LocationMode _mode = LocationMode.Places;
    private string _locations = "";
    private string _center = "";
    private double _radiusKm = 10;
    private int _travelMinutes = 30;
    private TravelMode _travelBy = TravelMode.Car;
    private decimal? _priceMin, _priceMax;
    private double? _surfaceMin, _surfaceMax;
    private int? _roomsMin, _roomsMax, _bedroomsMin;
    private string _furnished = "any";
    private string _include = "";
    private string _exclude = "";
    private HashSet<string> _sites = ["bienici", "seloger"];
    private int _refresh = 6;
    private bool _active = true;

    protected override void OnParametersSet()
    {
        if (Id is null) return;
        _existing = Store.Get(Id);
        if (_existing is null)
        {
            _notFound = true;
            return;
        }
        var p = _existing;
        _name = p.Name;
        _transaction = p.Transaction;
        _flat = p.PropertyTypes.Contains("flat");
        _house = p.PropertyTypes.Contains("house");
        _mode = p.LocationMode;
        _locations = string.Join("\n", p.Locations.Select(l => l.Query));
        _center = p.CenterQuery ?? "";
        _radiusKm = p.RadiusKm;
        _travelMinutes = p.TravelMinutes;
        _travelBy = p.TravelBy;
        (_priceMin, _priceMax, _surfaceMin, _surfaceMax) = (p.PriceMin, p.PriceMax, p.SurfaceMin, p.SurfaceMax);
        (_roomsMin, _roomsMax, _bedroomsMin) = (p.RoomsMin, p.RoomsMax, p.BedroomsMin);
        _furnished = p.Furnished switch { true => "yes", false => "no", _ => "any" };
        _include = string.Join(", ", p.KeywordsInclude);
        _exclude = string.Join(", ", p.KeywordsExclude);
        _sites = [.. p.Sites];
        _refresh = p.AutoRefreshHours;
        _active = p.Active;
    }

    private void ToggleSite(string id, bool on)
    {
        if (on) _sites.Add(id);
        else _sites.Remove(id);
    }

    private void Save(bool run)
    {
        _errors.Clear();
        var queries = _locations.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        var sites = _sites.Where(s => Sites.Get(s) is { Available: true }).ToList();
        if (string.IsNullOrWhiteSpace(_name)) _errors.Add("Donner un nom au projet.");
        if (!_flat && !_house) _errors.Add("Choisir au moins un type de bien.");
        if (_mode == LocationMode.Places && queries.Count == 0) _errors.Add("Indiquer au moins un lieu (ville, code postal ou département).");
        if (_mode != LocationMode.Places && string.IsNullOrWhiteSpace(_center)) _errors.Add("Indiquer le point de départ (adresse ou ville).");
        if (_mode == LocationMode.Radius && _radiusKm is <= 0 or > 200) _errors.Add("Rayon entre 1 et 200 km.");
        if (_mode == LocationMode.TravelTime && _travelMinutes is < 5 or > 120) _errors.Add("Temps de trajet entre 5 et 120 minutes.");
        if (sites.Count == 0) _errors.Add("Choisir au moins un site.");
        if (_priceMin > _priceMax || _surfaceMin > _surfaceMax || _roomsMin > _roomsMax) _errors.Add("Un minimum est supérieur au maximum.");
        if (_errors.Count > 0) return;

        var p = _existing ?? new SearchProject { Id = SearchProject.NewId() };
        p.Name = _name.Trim();
        p.PropertyTypes = [.. new[] { _flat ? "flat" : null, _house ? "house" : null }.OfType<string>()];
        // Transaction changée : les lieux reconnus par les sites (qui en dépendent) sont redemandés.
        if (_existing is not null && _existing.Transaction != _transaction) p.PlaceCache.Clear();
        p.Transaction = _transaction;
        p.LocationMode = _mode;
        p.Locations = queries.Select(q => new ProjectLocation { Query = q }).ToList();
        if (!string.Equals(p.CenterQuery?.Trim(), _center.Trim(), StringComparison.OrdinalIgnoreCase)) p.Center = null;
        p.CenterQuery = string.IsNullOrWhiteSpace(_center) ? null : _center.Trim();
        p.RadiusKm = _radiusKm;
        p.TravelMinutes = _travelMinutes;
        p.TravelBy = _travelBy;
        // La zone (mode rayon / temps de trajet) est recalculée au prochain lancement si elle a changé (empreinte).
        (p.PriceMin, p.PriceMax, p.SurfaceMin, p.SurfaceMax) = (_priceMin, _priceMax, _surfaceMin, _surfaceMax);
        (p.RoomsMin, p.RoomsMax, p.BedroomsMin) = (_roomsMin, _roomsMax, _bedroomsMin);
        p.Furnished = _furnished switch { "yes" => true, "no" => false, _ => null };
        p.KeywordsInclude = SplitWords(_include);
        p.KeywordsExclude = SplitWords(_exclude);
        p.Sites = sites;
        p.AutoRefreshHours = _refresh;
        p.Active = _active;
        Store.Save(p);
        if (run) _ = Task.Run(() => Runner.RunAsync(p.Id, CancellationToken.None));
        Nav.NavigateTo($"/projets/{p.Id}");
    }

    private void Delete()
    {
        if (Id is not null) Store.Delete(Id);
        Nav.NavigateTo("/projets");
    }

    private static List<string> SplitWords(string text) =>
        text.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
}
